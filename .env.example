# Local Flask configuration. Disable debug on public deployments.
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
SECRET_KEY=

# Postgres (recommended) or MongoDB required for durable Vercel storage.
DATABASE_URL=
# Use the Neon/Vercel pooled Postgres URL; POSTGRES_URL is also accepted.
# When Postgres is configured it takes precedence over MongoDB.
MONGODB_URI=
MONGODB_DATABASE=phishing_detection
# MONGO_URI is also accepted for compatibility.
LOCAL_DB_PATH=
SCAN_CACHE_TTL=300
SCAN_REQUESTS_PER_MINUTE=12

# Server-side credentials only. Never commit .env.
VIRUSTOTAL_API_KEY=
VT_REQUESTS_PER_MINUTE=4
SAFE_BROWSING_API_KEY=

# Genuine LLM evidence reasoning: auto / groq / openai / ollama / none.
# auto selects Groq, then OpenAI, then a configured Ollama model.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
